{
  base."00" = "262626"; # Primary background (applications, terminal background)
  base."01" = "3a3a3a"; # Alternate / darker background (status bars, panels, sidebars)
  base."02" = "4e4e4e"; # Selection background (selected lines, cursor line, active item highlights)
  base."03" = "8a8a8a"; # Muted text / comments (low contrast text)
  base."04" = "949494"; # Secondary UI elements / borders / inactive indicators
  base."05" = "dab997"; # Main foreground text
  base."06" = "d5c4a1"; # Secondary / bright text
  base."07" = "ebdbb2"; # Maximum brightness text / headings
  base."08" = "d75f5f"; # Red (errors, deletion, critical alerts)
  base."09" = "ff8700"; # Orange (warnings, constants, integers)
  base."0A" = "ffaf00"; # Yellow (classes, search highlights, warnings)
  base."0B" = "afaf00"; # Green (strings, success indicators, additions)
  base."0C" = "85ad85"; # Cyan (regex, escape characters, support functions)
  base."0D" = "83adad"; # Blue (functions, primary methods, headings)
  base."0E" = "d485ad"; # Purple (keywords, storage types, control flow)
  base."0F" = "d65d0e"; # Magenta (deprecated items, secondary accents)
}
