{
  base."00" = "1d2021"; # Primary background (applications, terminal background)
  base."01" = "3c3836"; # Alternate / darker background (status bars, panels, sidebars)
  base."02" = "504945"; # Selection background (selected lines, cursor line, active item highlights)
  base."03" = "665c54"; # Muted text / comments (low contrast text)
  base."04" = "bdae93"; # Secondary UI elements / borders / inactive indicators
  base."05" = "d5c4a1"; # Main foreground text
  base."06" = "ebdbb2"; # Secondary / bright text
  base."07" = "fbf1c7"; # Maximum brightness text / headings
  base."08" = "fb4934"; # Red (errors, deletion, critical alerts)
  base."09" = "fe8019"; # Orange (warnings, constants, integers)
  base."0A" = "fabd2f"; # Yellow (classes, search highlights, warnings)
  base."0B" = "b8bb26"; # Green (strings, success indicators, additions)
  base."0C" = "8ec07c"; # Cyan (regex, escape characters, support functions)
  base."0D" = "83a598"; # Blue (functions, primary methods, headings)
  base."0E" = "d3869b"; # Purple (keywords, storage types, control flow)
  base."0F" = "d65d0e"; # Magenta (deprecated items, secondary accents)
}
