	base."0A" = "b57614"; # Yellow (classes, search highlights, warnings)
	base."0B" = "79740e"; # Green (strings, success indicators, additions)
	base."0C" = "427b58"; # Cyan (regex, escape characters, support functions)
	base."0D" = "076678"; # Blue (functions, primary methods, headings)
