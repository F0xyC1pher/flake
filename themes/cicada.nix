{
	defaultAccent = {
		level = "normal";
		color = "blue";
	};
	base = {
		"00" = "#212121"; # Primary background (applications, terminal background)
		"01" = "#424242"; # Alternate / darker background (status bars, panels, sidebars)
		"02" = "#616161"; # Selection background (selected lines, cursor line, active item highlights)
		"03" = "#757575"; # Muted text / comments (low contrast text)
		"04" = "#9e9e9e"; # Secondary UI elements / borders / inactive indicators
		"05" = "#bdbdbd"; # Main foreground text
		"06" = "#e0e0e0"; # Secondary / bright text
		"07" = "#eeeeee"; # Maximum brightness text / headings
		"08" = "#EF5350"; # Red (errors, deletion, critical alerts)
		"09" = "#FFA726"; # Orange (warnings, constants, integers)
		"0A" = "#FFEE58"; # Yellow (classes, search highlights, warnings)
		"0B" = "#26A69A"; # Green (strings, success indicators, additions)
		"0C" = "#26C6DA"; # Cyan (regex, escape characters, support functions)
		"0D" = "#29B6F6"; # Blue (functions, primary methods, headings)
		"0E" = "#AB47BC"; # Purple (keywords, storage types, control flow)
		"0F" = "#EC407A"; # Magenta (deprecated items, secondary accents)
	};
}
