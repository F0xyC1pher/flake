{
	defaultAccent = {
		level = "normal";
		color = "red";
	};
	base = {
		"00" = "#060606"; # Primary background (applications, terminal background)
		"01" = "#161616"; # Alternate / darker background (status bars, panels, sidebars)
		"02" = "#262626"; # Selection background (selected lines, cursor line, active item highlights)
		"03" = "#968686"; # Muted text / comments (low contrast text)
		"04" = "#a69696"; # Secondary UI elements / borders / inactive indicators
		"05" = "#d6c6c6"; # Main foreground text
		"06" = "#e6d6d6"; # Secondary / bright text
		"07" = "#f6e6e6"; # Maximum brightness text / headings
		"08" = "#c65656"; # Red (errors, deletion, critical alerts)
		"09" = "#c69656"; # Orange (warnings, constants, integers)
		"0A" = "#c6c656"; # Yellow (classes, search highlights, warnings)
		"0B" = "#56c656"; # Green (strings, success indicators, additions)
		"0C" = "#56c6c6"; # Cyan (regex, escape characters, support functions)
		"0D" = "#5696c6"; # Blue (functions, primary methods, headings)
		"0E" = "#9656c6"; # Purple (keywords, storage types, control flow)
		"0F" = "#c656c6"; # Magenta (deprecated items, secondary accents)
	};
}
