{
  base."00" = "32302f"; # Primary background (applications, terminal background)
  base."01" = "3c3836"; # Alternate / darker background (status bars, panels, sidebars)
  base."02" = "5a524c"; # Selection background (selected lines, cursor line, active item highlights)
  base."03" = "7c6f64"; # Muted text / comments (low contrast text)
  base."04" = "bdae93"; # Secondary UI elements / borders / inactive indicators
  base."05" = "ddc7a1"; # Main foreground text
  base."06" = "ebdbb2"; # Secondary / bright text
  base."07" = "fbf1c7"; # Maximum brightness text / headings
  base."08" = "ea6962"; # Red (errors, deletion, critical alerts)
  base."09" = "e78a4e"; # Orange (warnings, constants, integers)
  base."0A" = "d8a657"; # Yellow (classes, search highlights, warnings)
  base."0B" = "a9b665"; # Green (strings, success indicators, additions)
  base."0C" = "89b482"; # Cyan (regex, escape characters, support functions)
  base."0D" = "7daea3"; # Blue (functions, primary methods, headings)
  base."0E" = "d3869b"; # Purple (keywords, storage types, control flow)
  base."0F" = "bd6f3e"; # Magenta (deprecated items, secondary accents)
}
