{
  base."00" = "fbf1c7"; # Primary background (applications, terminal background)
  base."01" = "f2e5bc"; # Alternate / darker background (status bars, panels, sidebars)
  base."02" = "d5c4a1"; # Selection background (selected lines, cursor line, active item highlights)
  base."03" = "bdae93"; # Muted text / comments (low contrast text)
  base."04" = "665c54"; # Secondary UI elements / borders / inactive indicators
  base."05" = "654735"; # Main foreground text
  base."06" = "3c3836"; # Secondary / bright text
  base."07" = "282828"; # Maximum brightness text / headings
  base."08" = "c14a4a"; # Red (errors, deletion, critical alerts)
  base."09" = "c35e0a"; # Orange (warnings, constants, integers)
  base."0A" = "b47109"; # Yellow (classes, search highlights, warnings)
  base."0B" = "6c782e"; # Green (strings, success indicators, additions)
  base."0C" = "4c7a5d"; # Cyan (regex, escape characters, support functions)
  base."0D" = "45707a"; # Blue (functions, primary methods, headings)
  base."0E" = "945e80"; # Purple (keywords, storage types, control flow)
  base."0F" = "e78a4e"; # Magenta (deprecated items, secondary accents)
}
